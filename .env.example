MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=mef
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=mef

ADMIN_EMAIL=admin@mef-organizasyon.com
ADMIN_PASSWORD=changeme
SETTINGS_ENCRYPTION_KEY=generate-a-random-64-char-hex-string-here
SESSION_SECRET=generate-a-different-random-64-char-hex-string-here

WEB_PORT=8081
HTTPS_PORT=443

# Set to true once nginx is serving the site over HTTPS on HTTPS_PORT —
# otherwise the admin login cookie won't come back over plain HTTP and
# login will silently fail.
COOKIE_SECURE=false
