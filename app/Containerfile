FROM image-registry.openshift-image-registry.svc:5000/openshift/nodejs:22-ubi9-minimal AS deps
WORKDIR /opt/app-root/src
USER 0
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

FROM image-registry.openshift-image-registry.svc:5000/openshift/nodejs:22-ubi9-minimal AS builder
WORKDIR /opt/app-root/src
USER 0
COPY --from=deps /opt/app-root/src/node_modules ./node_modules
COPY . .
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate && npm run build

FROM image-registry.openshift-image-registry.svc:5000/openshift/nodejs:22-ubi9-minimal AS runner
WORKDIR /opt/app-root/src
USER 0
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=8080

COPY --from=builder /opt/app-root/src/node_modules ./node_modules
COPY --from=builder /opt/app-root/src/public ./public
COPY --from=builder /opt/app-root/src/.next ./.next
COPY --from=builder /opt/app-root/src/prisma ./prisma
COPY --from=builder /opt/app-root/src/package.json ./package.json
COPY --from=builder /opt/app-root/src/next.config.js ./next.config.js

RUN chown -R 1001:0 /opt/app-root/src && chmod -R g=u /opt/app-root/src

USER 1001
EXPOSE 8080
CMD ["npm", "run", "start"]
